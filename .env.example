# Database
DATABASE_URL=postgresql://schoolpilot:schoolpilot_dev@localhost:5432/schoolpilot
SESSION_DB_POOL_MAX=2

# Redis
REDIS_URL=redis://:schoolpilot_d3v!Redis2025@localhost:6380
# Production Redis with required transit encryption must use rediss://...

# Server
PORT=4000
NODE_ENV=development
APP_ENV=development
PUBLIC_BASE_URL=http://localhost:4000
DB_QUERY_DIAGNOSTICS=false
RUN_MIGRATIONS_ON_STARTUP=false
RUN_MIGRATIONS_ONLY=false
# Migration one-off override only; do not set this on API/worker services.
# After the inventory is zero, deploy with --apply-staff-identity-contracts.
# That guarded stage-five path sets this true only for the atomic contract task.
APPLY_STAFF_IDENTITY_CONTRACT_MIGRATIONS=false
SCHEDULER_ENABLED=true
# Singleton worker read-only staff ownership scan (bounded to 5-1440 minutes).
STAFF_IDENTITY_INTEGRITY_SCAN_INTERVAL_MINUTES=60
DB_POOL_MAX=2
SCHEDULER_DB_POOL_MAX=5
SCHEDULER_LOCK_POOL_MAX=8

# Session — generate with: openssl rand -hex 32
SESSION_SECRET=

# JWT (for GoPilot-style token auth) — generate with: openssl rand -hex 32
JWT_SECRET=
JWT_EXPIRY=7d
# Optional independent PassPilot kiosk signing/HMAC keys. When omitted, the
# kiosk token and health-key derivation fall back to JWT_SECRET.
KIOSK_TOKEN_SECRET=
KIOSK_HEALTH_HMAC_SECRET=
# Optional independent HMAC key for one-use ClassPilot -> PassPilot launch
# tickets and their school-scoped managed-device continuity projection.
CLASSPILOT_KIOSK_TICKET_HMAC_SECRET=

# Protocol-v3 capabilities default off. The 2.7.1 rollout enables them for the
# managed test cohort first, then sets every repaired capability globally on.
CLASSPILOT_PROTOCOL_V3_ENABLED=false
CLASSPILOT_CAP_SCOPED_AUTHORITY_CHECKS_V1=false
CLASSPILOT_CAP_AUTH_BOUND_TELEMETRY_V1=false
CLASSPILOT_CAP_EXACT_BINDING_ACK_V2=false
CLASSPILOT_CAP_EXACT_TAB_CLOSE_V2=false
CLASSPILOT_CAP_STUDENT_CHAT_IDEMPOTENCY_V1=false
CLASSPILOT_CAP_SCREENSHOT_OBSERVATION_LEASE_V1=false
CLASSPILOT_CAP_SAFETY_EVIDENCE_CAPTURE_V1=false
CLASSPILOT_CAP_LIVE_VIEW_ICE_SERVERS_V1=false
CLASSPILOT_CAP_KIOSK_LAUNCH_TICKET_V1=false
CLASSPILOT_CAP_KIOSK_LAUNCH_TICKET_V2=false
# Provisioning injects two comma-separated hosts and the Secrets Manager value
# into ECS. Keep both blank locally to leave relay credentials unavailable.
CLASSPILOT_TURN_HOSTS=
CLASSPILOT_TURN_REST_SECRET=
CLASSPILOT_STUN_URLS=
# Optional per-school activation registry. When present, every omitted or
# malformed capability fails closed. Modes: off, observe, canary, on.
# CLASSPILOT_CAPABILITY_ROLLOUTS_JSON={"screenshotObservationLeaseV1":{"mode":"canary","schoolIds":["school-id"],"canaryPercent":100}}

# Immutable session report-v2 rollout: legacy | shadow | on. Missing or
# malformed values fail closed to legacy. Shadow persists/exposes/emails v1
# and emits identifier-free v2 comparison telemetry only.
CLASSPILOT_SESSION_REPORT_V2_MODE=legacy

# Device JWT (for ClassPilot Chrome extension) — generate with: openssl rand -hex 32
STUDENT_TOKEN_SECRET=
CLASSPILOT_EXTENSION_ID=

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_TOKEN_ENCRYPTION_KEY=

# Google Workspace roster connector (Domain-Wide Delegation)
# Preferred keyless mode: set GOOGLE_ROSTER_SA_EMAIL + GOOGLE_ROSTER_SA_CLIENT_ID
# and grant the runtime identity permission to sign JWTs for that service account.
# Fallback: set GOOGLE_ROSTER_SA_KEY_JSON to raw or base64 service-account JSON.
GOOGLE_ROSTER_SA_EMAIL=
GOOGLE_ROSTER_SA_CLIENT_ID=
GOOGLE_ROSTER_SA_KEY_JSON=

# SendGrid (optional for local dev)
SENDGRID_API_KEY=
SENDGRID_FROM=noreply@example.com
ADMIN_EMAIL=admin@example.com

# Stripe (optional for local dev)
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# AI provider (optional for local dev; required for AI chat + content classification)
ANTHROPIC_API_KEY=
# AI chat stays off unless explicitly enabled after privacy/subprocessor review.
AI_CHAT_ENABLED=false

# Error tracking — Sentry (OPTIONAL, GATED OFF by default).
# Leave BLANK until you have (1) signed Sentry's DPA and (2) added Sentry to the
# public subprocessors list. When blank, no error data leaves the system; the
# durable error_logs Postgres table still captures everything regardless.
SENTRY_DSN=

# Developer error alerts via Telegram (optional). If unset, Telegram alerts are
# silently skipped (email alerts to ADMIN_EMAIL still fire).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Super Admin
SUPER_ADMIN_EMAIL=admin@example.com

# Super Admin SOC 2 dashboard (optional locally; required in production for GitHub data/resync)
SOC2_DASHBOARD_GITHUB_TOKEN=
SOC2_DASHBOARD_REPO=bzinkan/SchoolPilot
SOC2_APPROVAL_ISSUE_NUMBER=146
SOC2_DASHBOARD_WORKFLOW=ci-build.yml

# CORS (comma-separated frontend origins)
CORS_ALLOWLIST=http://localhost:5000,http://localhost:3000,http://localhost:5173,http://localhost:5174

# Production RLS gate. Leave unset locally unless testing RLS behavior.
RLS_GUC_ENABLED=false
RLS_ENABLED_TABLES=
# Daily ClassPilot usage aggregation rollout: legacy | shadow | set_based.
# Keep shadow for three complete school days before switching to set_based.
CLASSPILOT_DAILY_USAGE_ROLLUP_MODE=shadow
