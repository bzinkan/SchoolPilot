# Database
DATABASE_URL=postgresql://schoolpilot:schoolpilot_dev@localhost:5432/schoolpilot
SESSION_DB_POOL_MAX=2

# Redis
REDIS_URL=redis://:schoolpilot_d3v!Redis2025@localhost:6380
# Production Redis with required transit encryption must use rediss://...

# Server
PORT=4000
NODE_ENV=development
APP_ENV=development
PUBLIC_BASE_URL=http://localhost:4000
DB_QUERY_DIAGNOSTICS=false
RUN_MIGRATIONS_ON_STARTUP=false
RUN_MIGRATIONS_ONLY=false
# Migration one-off override only; do not set this on API/worker services.
# After the inventory is zero, deploy with --apply-staff-identity-contracts.
# That guarded stage-five path sets this true only for the atomic contract task.
APPLY_STAFF_IDENTITY_CONTRACT_MIGRATIONS=false
SCHEDULER_ENABLED=true
# Singleton worker read-only staff ownership scan (bounded to 5-1440 minutes).
STAFF_IDENTITY_INTEGRITY_SCAN_INTERVAL_MINUTES=60
DB_POOL_MAX=2
SCHEDULER_DB_POOL_MAX=5
SCHEDULER_LOCK_POOL_MAX=8

# Session — generate with: openssl rand -hex 32
SESSION_SECRET=

# JWT (for GoPilot-style token auth) — generate with: openssl rand -hex 32
JWT_SECRET=
JWT_EXPIRY=7d
# Optional independent PassPilot kiosk signing/HMAC keys. When omitted, the
# kiosk token and health-key derivation fall back to JWT_SECRET.
KIOSK_TOKEN_SECRET=
KIOSK_HEALTH_HMAC_SECRET=
# Optional independent HMAC key for one-use ClassPilot -> PassPilot launch
# tickets and their school-scoped managed-device continuity projection.
CLASSPILOT_KIOSK_TICKET_HMAC_SECRET=

# Protocol-v3 capabilities default off. The 2.7.1 rollout enables them for the
# managed test cohort first, then sets every repaired capability globally on.
CLASSPILOT_PROTOCOL_V3_ENABLED=false
CLASSPILOT_CAP_SCOPED_AUTHORITY_CHECKS_V1=false
CLASSPILOT_CAP_AUTH_BOUND_TELEMETRY_V1=false
CLASSPILOT_CAP_EXACT_BINDING_ACK_V2=false
CLASSPILOT_CAP_EXACT_TAB_CLOSE_V2=false
CLASSPILOT_CAP_STUDENT_CHAT_IDEMPOTENCY_V1=false
CLASSPILOT_CAP_SCREENSHOT_OBSERVATION_LEASE_V1=false
CLASSPILOT_CAP_SCREENSHOT_TRACKING_WINDOW_LEASE_V1=false
CLASSPILOT_CAP_SCREENSHOT_ACTIVE_OBSERVATION_CADENCE_V1=false
CLASSPILOT_CAP_SAFETY_EVIDENCE_CAPTURE_V1=false
CLASSPILOT_CAP_LIVE_VIEW_ICE_SERVERS_V1=false
CLASSPILOT_CAP_KIOSK_LAUNCH_TICKET_V1=false
CLASSPILOT_CAP_STUDENT_AUTH_GATE_PRESENCE_V1=false
CLASSPILOT_CAP_LATE_SIGNIN_RESTRICTION_SSO_V1=false
CLASSPILOT_CAP_RESTRICTION_AUTH_PASS_THROUGH_V1=false
CLASSPILOT_CAP_KIOSK_LAUNCH_TICKET_V2=false
# Precise Waypoints and Flight Paths ("This resource only", sections, single
# YouTube videos, Docs, Forms and Drive files). Negotiated only by ClassPilot
# 2.10.0; every other client is refused per target and never receives a host
# fallback. Production changes go through the precise-restriction-resources
# profiles of scripts/deploy-classpilot-runtime-config.ps1.
CLASSPILOT_CAP_PRECISE_RESTRICTION_RESOURCES_V1=false
# Requires the additive private-chat lifecycle migration and its reviewed RLS bundle.
# Turning this off stops new issuance; persisted expiration fences remain enforced.
CLASSPILOT_CAP_PRIVATE_CHAT_LIFECYCLE_V1=false
# Legacy TURN inputs for the retired Live View ICE path (liveViewIceServersV1).
# The TURN nodes are parked (docs/CLASSPILOT_TURN_PARKING.md) and no runtime
# profile writes these. Keep all three blank locally so relay credentials stay
# unavailable.
CLASSPILOT_TURN_HOSTS=
CLASSPILOT_TURN_REST_SECRET=
CLASSPILOT_STUN_URLS=
# Legacy Live View WebSocket signaling. Off by default: a staff request-stream
# is answered with live-view-unavailable/LIVE_VIEW_RETIRED and offer, answer and
# ice frames are dropped (stop-share always passes). Local and test use only;
# nothing sets it in production. Never enable it in production.
CLASSPILOT_LIVE_VIEW_SIGNALING_ENABLED=false
# Optional per-school activation registry. When present, every omitted or
# malformed capability fails closed. Modes: off, observe, canary, on.
# CLASSPILOT_CAPABILITY_ROLLOUTS_JSON={"screenshotObservationLeaseV1":{"mode":"canary","schoolIds":["school-id"],"canaryPercent":100}}
# Sign-in pass-through remains exact-school scoped during rollout; pair this
# registry entry with CLASSPILOT_CAP_RESTRICTION_AUTH_PASS_THROUGH_V1=true.
# CLASSPILOT_CAPABILITY_ROLLOUTS_JSON={"restrictionAuthPassThroughV1":{"mode":"on","schoolIds":["exact-school-id"]}}
# Re-enable after restriction-auth-off only with the ordered gate-on then
# policy-PATCH sequence in docs/CLASSPILOT_RESTRICTION_AUTH_ROLLOUT.md.

# Immutable session report-v2 rollout: legacy | shadow | on. Missing or
# malformed values fail closed to legacy. Shadow persists/exposes/emails v1
# and emits identifier-free v2 comparison telemetry only.
CLASSPILOT_SESSION_REPORT_V2_MODE=legacy

# Scheduled Class/testing display and authority rollout. ON for every school
# when unset; set to off only as a global kill switch. A client that cannot
# negotiate scheduledClassroomV1 is downgraded to its student-session authority
# per device, which is how that device behaved before this feature existed, so
# an old fleet loses nothing by this being on. This does not start the boundary
# worker.
CLASSPILOT_SCHEDULED_CLASSROOM_MODE=on
# Comma-separated schools that must NOT receive it. Empty means every school.
# A malformed entry refuses the rollout everywhere rather than guessing.
CLASSPILOT_SCHEDULED_CLASSROOM_EXCLUDED_SCHOOL_IDS=
# Protocol capability kill switch for scheduledClassroomV1, boolean like every
# other capability flag and managed by the runtime-config deploy path. The
# capability also needs a scheduledClassroomV1 entry in the rollout registry and
# CLASSPILOT_SCHEDULED_CLASSROOM_MODE=on for the school.
CLASSPILOT_CAP_SCHEDULED_CLASSROOM_V1=true

# The one-second schedule boundary worker, gated separately from the display
# rollout above. Enabling it drains a fleet-wide next_boundary_at backlog four
# schools at a time, and the per-school allowlist is applied after the claim, so
# non-allowlisted schools still consume worker slots. Turn this on deliberately
# and on its own, never as a side effect of the display rollout.
CLASSPILOT_SCHEDULE_BOUNDARY_WORKER_MODE=off

# School Library for Flight Paths and Block Lists: owners can share items with
# their school, administrators can mark shared items Official, and teachers can
# apply or copy them. Off unless exactly "on"; with it off the Teaching tools
# APIs keep their previous responses and dispatch resolves only a teacher's own
# items. Optional comma-separated allowlist: empty means every school when the
# mode is on; a malformed entry turns the library off everywhere. Production
# values are changed only through the governed runtime-configuration tooling.
CLASSPILOT_SHARED_TEACHING_RESOURCES_MODE=off
CLASSPILOT_SHARED_TEACHING_RESOURCES_SCHOOL_IDS=

# Screen previews for supervision-claimed students. off | observe | on.
# ON when unset: a teacher who has claimed a student has taken responsibility
# for them, and a tile with no screen is the bug this rollout exists to fix.
# observe runs every authorization and lease path and emits counters while still
# discarding the frame, which is useful for watching a change in production but
# is a deliberate choice rather than the resting state. An unrecognized string
# still resolves to off so a typo cannot retain a frame, and boot fails on one
# so an intended enablement can never silently read as off.
CLASSPILOT_SUPERVISION_PREVIEW_MODE=on
# Comma-separated schools that must NOT receive previews. Empty means every
# school. A malformed entry refuses previews everywhere rather than guessing.
CLASSPILOT_SUPERVISION_PREVIEW_EXCLUDED_SCHOOL_IDS=

# Hourly safety spine / messaging retention purge: count | delete. count (the
# default, also for any other value) only logs how many rows would be removed.
# delete removes ClassPilot AI decisions, student timeline events, messages,
# and expired chat deliveries past each school's retention window, plus closed
# safety cases past max(retention, 90 days); open safety cases never purge.
# Flip to delete only after a full day of sane count-mode totals.
CLASSPILOT_RETENTION_PURGE_SPINE_MODE=count

# Device JWT (for ClassPilot Chrome extension) — generate with: openssl rand -hex 32
STUDENT_TOKEN_SECRET=
CLASSPILOT_EXTENSION_ID=

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_TOKEN_ENCRYPTION_KEY=

# Microsoft Entra ID staff sign-in (optional). "Continue with Microsoft" stays
# hidden until both are set; see docs/MICROSOFT_SIGN_IN.md.
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
# MICROSOFT_CALLBACK_URL=http://localhost:4000/api/auth/microsoft/callback

# Google Workspace roster connector (Domain-Wide Delegation)
# Preferred keyless mode: set GOOGLE_ROSTER_SA_EMAIL + GOOGLE_ROSTER_SA_CLIENT_ID
# and grant the runtime identity permission to sign JWTs for that service account.
# Fallback: set GOOGLE_ROSTER_SA_KEY_JSON to raw or base64 service-account JSON.
GOOGLE_ROSTER_SA_EMAIL=
GOOGLE_ROSTER_SA_CLIENT_ID=
GOOGLE_ROSTER_SA_KEY_JSON=

# ClassPilot "Import from Google Classroom" (admin class import through the
# roster connector above). Both flags default ON; set exactly "false" to hide
# the feature. CLASSPILOT_CLASSROOM_IMPORT_ENABLED gates the API routes;
# VITE_CLASSPILOT_CLASSROOM_IMPORT_ENABLED is a Vite build-time variable for
# the admin UI (rebuild schoolpilot-app after changing it).
# The connector's delegated admin must hold Google Classroom admin privilege
# (a Google Workspace super admin) or the domain-wide course listing is empty.
CLASSPILOT_CLASSROOM_IMPORT_ENABLED=
VITE_CLASSPILOT_CLASSROOM_IMPORT_ENABLED=

# SendGrid (optional for local dev)
SENDGRID_API_KEY=
SENDGRID_FROM=noreply@example.com
ADMIN_EMAIL=admin@example.com

# Stripe (optional for local dev)
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# AI providers (optional for local dev). Gemini powers ClassPilot URL/title
# classification; Anthropic remains only for MailPilot email review and the
# optional staff chat assistant.
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
# Class chat safety: keyword rules always run; "hit" lets the AI provider grade a
# message that already matched, "off" keeps every message inside the system.
CLASSPILOT_CHAT_AI_SCAN_MODE=hit
# AI chat stays off unless explicitly enabled after privacy/subprocessor review.
AI_CHAT_ENABLED=false

# Error tracking — Sentry (OPTIONAL, GATED OFF by default).
# Leave BLANK until you have (1) signed Sentry's DPA and (2) added Sentry to the
# public subprocessors list. When blank, no error data leaves the system; the
# durable error_logs Postgres table still captures everything regardless.
SENTRY_DSN=

# Developer error alerts via Telegram (optional). If unset, Telegram alerts are
# silently skipped (email alerts to ADMIN_EMAIL still fire).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Super Admin
SUPER_ADMIN_EMAIL=admin@example.com

# Super Admin SOC 2 dashboard (optional locally; required in production for GitHub data/resync)
SOC2_DASHBOARD_GITHUB_TOKEN=
SOC2_DASHBOARD_REPO=bzinkan/SchoolPilot
SOC2_APPROVAL_ISSUE_NUMBER=146
SOC2_DASHBOARD_WORKFLOW=ci-build.yml

# CORS (comma-separated frontend origins)
CORS_ALLOWLIST=http://localhost:5000,http://localhost:3000,http://localhost:5173,http://localhost:5174

# Production RLS gate. Leave unset locally unless testing RLS behavior.
RLS_GUC_ENABLED=false
RLS_ENABLED_TABLES=
# Automatic kiosk containment switch. False disables automatic checkout while preserving returns.
PASSPILOT_AUTOMATIC_KIOSK_ENABLED=true
# PassPilot issuance rules (daily/period limits, destination capacity, encounter restrictions).
# Only off/on. "on" still stays off unless RLS_GUC_ENABLED=true and RLS_ENABLED_TABLES lists the
# passpilotRules bundle. Production changes go through the governed runtime-config activation.
PASSPILOT_RULES_MODE=off
# Staff-only, one-time appointments. Requires the appointment table's RLS
# admission and a configured school-year boundary; rollout stays separate.
PASSPILOT_APPOINTMENTS_MODE=off
# Retained-record Reports: exact off/v2. Requires RLS binding and the complete
# preserved 128-table appointment admission; production activation uses the
# governed product runtime setter after API/worker report contract v2 plus
# authority-fence v1 source is serving.
PASSPILOT_REPORTS_MODE=off
# Internal global controls, not school settings. Once on, all eligible ClassPilot staff
# receive their own private workspace, including staff at newly entitled schools.
MYDESK_MODE=off
# Seating and AI require MYDESK_MODE=on. Only the exact values off/on are accepted.
MYDESK_SEATING_MODE=off
# Complete provider/account review before AI activation. Cleanup remains on.
MYDESK_AI_IMPORT_MODE=off
# Separate reviewed contact-extraction release; requires MYDESK_MODE=on, not discipline AI.
STUDENT_INFORMATION_AI_IMPORT_MODE=off
MYDESK_AI_IMPORT_MODEL=claude-opus-5-5
MYDESK_AI_IMPORT_TEACHER_DAILY_PAGES=100
MYDESK_AI_IMPORT_SCHOOL_DAILY_PAGES=500
MYDESK_ATTACHMENTS_BUCKET=
# Daily ClassPilot usage rollup writer: shadow (default) | set_based (alias: on) | legacy.
# Unset, empty or unrecognized values, off included, run shadow. Production switches to on
# only through the governed product runtime tool after three clean shadow school days
# (docs/SCALE_READINESS.md, "Daily usage rollup mode and promotion").
CLASSPILOT_DAILY_USAGE_ROLLUP_MODE=shadow
# Monitored Browser Time rollups (classpilot_usage_rollups) and the admin Digital Usage API.
# Only off/on. "on" still stays off unless RLS_GUC_ENABLED=true and RLS_ENABLED_TABLES lists
# classpilot_usage_rollups, and Digital Usage also needs the rollup on. Production changes go
# through the governed product runtime tool (docs/CLASSPILOT_DIGITAL_USAGE.md).
CLASSPILOT_USAGE_ROLLUP_MODE=off
CLASSPILOT_DIGITAL_USAGE_MODE=off
